# Application
APP_NAME="Qubiq"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://qubiq.herculesprojects.net
GITHUB_URL=https://github.com/MrSwagger1337/Qubiq
APP_LOCALE=en
APP_TIMEZONE=UTC
# Optional HMAC secret used for privacy-preserving rate-limit key hashing (auto-derived if empty in dev)
APP_KEY=

# Resource & QR Limits
QR_MAX_PAYLOAD_BYTES=2953
QR_MIN_SIZE=128
QR_MAX_SIZE=2048
QR_DEFAULT_SIZE=1000
QR_DEFAULT_ECC=M
QR_DEFAULT_QUIET_ZONE=4
REQUEST_MAX_BODY_BYTES=3145728

# Logo Upload Security Limits
LOGO_MAX_BYTES=2097152
LOGO_MAX_DIMENSION=2048
LOGO_MAX_PIXELS=4194304
LOGO_MAX_COVERAGE_RATIO=0.28

# Optional Dynamic QR Codes & Privacy-Respecting Analytics
DYNAMIC_QR_ENABLED=true
DYNAMIC_QR_SAFE_INTERSTITIAL=false
DYNAMIC_QR_BLOCKED_DOMAINS=
ANALYTICS_ENABLED=true
ANALYTICS_TRACK_COUNTRY=false
ANALYTICS_TRUSTED_COUNTRY_HEADER=HTTP_CF_IPCOUNTRY
ANALYTICS_RETENTION_DAYS=365

# Storage & SQLite Database (outside public web root)
DB_DATABASE=storage/database/qubiq.sqlite
LOG_CHANNEL=file
LOG_LEVEL=info

# HTTP Security, Rate Limiting & CORS
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PREVIEW_PER_MINUTE=120
RATE_LIMIT_EXPORT_PER_MINUTE=60
RATE_LIMIT_API_PER_MINUTE=60
RATE_LIMIT_DYNAMIC_CREATE_PER_HOUR=20
CORS_ALLOWED_ORIGINS=
TRUSTED_PROXIES=
CSP_REPORT_ONLY=false

